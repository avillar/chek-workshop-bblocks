@prefix bblocks: <https://www.opengis.net/def/bblocks/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://avillar.github.io/ogc.bbr.template.example-profile> a skos:Concept,
        dcat:Dataset,
        bblocks:Model ;
    rdfs:label "My example profile" ;
    dct:abstract "Simple profile for demo purposes" ;
    dct:created "2024-11-10T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy "https://avillar.github.io/chek-workshop-bblocks/build/generateddocs/json-full/bbr/template/example-profile/index.json" ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy "https://avillar.github.io/chek-workshop-bblocks/bblock/ogc.bbr.template.example-profile" ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy "https://avillar.github.io/chek-workshop-bblocks/build/generateddocs/markdown/bbr/template/example-profile/index.md" ] ;
    dct:hasVersion "0.1" ;
    dct:modified "2025-02-12"^^xsd:date ;
    skos:inScheme <https://avillar.github.io/chek-workshop-bblocks/> ;
    dcat:keyword "chek-validation-profile" ;
    bblocks:hasShaclRule <https://avillar.github.io/chek-workshop-bblocks/_sources/example-profile/rules.shacl> ;
    bblocks:status <http://www.opengis.net/def/status/stable> .

<https://avillar.github.io/chek-workshop-bblocks/> a skos:ConceptScheme,
        dcat:Catalog ;
    rdfs:label "Building Blocks - My OGC Building Blocks repository" ;
    dct:abstract """This is an example text for the abstract. It should be short and to the point.
A "Tell me more" link will appear if there is an additional description with a longer explanation.
""" ;
    dct:description """The description can be longer. Both **the abstract** *and the description* support Markdown,
including [links](https://google.es).
""" ;
    skos:prefLabel "Building Blocks - My OGC Building Blocks repository" ;
    bblocks:hasValidationReport <https://avillar.github.io/chek-workshop-bblocks/build/tests/report.html> ;
    bblocks:imports <https://opengeospatial.github.io/bblocks/register.json> .

[] a prov:Activity ;
    prov:endedAtTime "2025-02-12T11:59:49.077265"^^xsd:dateTime ;
    prov:startedAtTime "2025-02-12T11:59:49.019170"^^xsd:dateTime ;
    prov:used [ a prov:Entity ;
            dct:format "application/json" ;
            dct:hasVersion "git:db4f396e72d3c67065ccaf98e9b4b7653c87a7de" ;
            rdfs:seeAlso <https://avillar.github.io/chek-workshop-bblocks/build/register.json> ],
        [ a prov:Entity ;
            dct:format "application/yaml" ;
            rdfs:seeAlso <file:///src/ogc/bblocks/register-context.yaml> ] ;
    prov:wasAssociatedWith [ a prov:Agent,
                schema:SoftwareApplication ;
            rdfs:label "OGC-NA tools" ;
            dct:hasVersion "0.3.56" ;
            rdfs:seeAlso <https://github.com/opengeospatial/ogc-na-tools> ] .

